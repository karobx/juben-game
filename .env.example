# Backend
FIREBASE_CREDENTIALS_PATH=
FIREBASE_STORAGE_BUCKET=
STORAGE_MODE=local
UPLOAD_DIR=uploads

# AI 場景插畫（至少設定其一；auto 時優先 OpenAI，其次 Pollinations）
# 切勿 commit 真實金鑰；僅放在本機 .env（已列入 .gitignore）
OPENAI_API_KEY=
POLLINATIONS_API_KEY=
IMAGE_PROVIDER=auto
OPENAI_IMAGE_MODEL=dall-e-3
POLLINATIONS_MODEL=zimage
ILLUSTRATIONS_DIR=illustrations

# Frontend (optional — dev server proxies /api to localhost:8000 when unset)
# VITE_API_BASE_URL=http://localhost:8000
